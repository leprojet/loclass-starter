\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{default}[2026/07/02 Default Theme]

\RequirePackage{xcolor}

% ==================================================
% Accent
% ==================================================

% ==================================================
% Brand Colors
% ==================================================

\definecolor{locBrandBlue}{HTML}{2F6FDD}
\definecolor{locBrandBlueDark}{HTML}{1F4F9F}
\definecolor{locBrandBlueLight}{HTML}{EEF4FF}

\definecolor{locText}{HTML}{1F2937}
\definecolor{locTextMuted}{HTML}{6B7280}
\definecolor{locSurface}{HTML}{F8FAFC}
\definecolor{locLine}{HTML}{D6DEE8}

\colorlet{locAccent}{locBrandBlue}

% ==================================================
% Semantic Colors
% ==================================================

\colorlet{locNote}{locBrandBlue}
\colorlet{locTip}{green!45!black}
\colorlet{locWarning}{orange!75!black}
\colorlet{locImportant}{red!60!black}

% ==================================================
% Box Colors
% ==================================================

\colorlet{locNoteBorder}{locNote}
\colorlet{locNoteBackground}{locBrandBlueLight}
\colorlet{locNoteTitle}{locNote}

\colorlet{locTipBorder}{locTip}
\colorlet{locTipBackground}{locTip!5}
\colorlet{locTipTitle}{locTip}

\colorlet{locWarningBorder}{locWarning}
\colorlet{locWarningBackground}{locWarning!5}
\colorlet{locWarningTitle}{locWarning}

\colorlet{locImportantBorder}{locImportant}
\colorlet{locImportantBackground}{locImportant!5}
\colorlet{locImportantTitle}{locImportant}

% ==================================================
% Neutral Colors
% ==================================================

\colorlet{locLight}{locSurface}
\colorlet{locMedium}{locLine}
\colorlet{locBorder}{locLine}
\colorlet{locDark}{locText}

% ==================================================
% Dimensions
% ==================================================

\newlength{\locBoxPaddingX}
\setlength{\locBoxPaddingX}{4mm}

\newlength{\locBoxPaddingY}
\setlength{\locBoxPaddingY}{2mm}

\newlength{\locBoxRadius}
\setlength{\locBoxRadius}{1mm}

\newlength{\locBoxSkip}
\setlength{\locBoxSkip}{8pt}

% ==================================================
% Rules
% ==================================================

\newcommand{\locBoxRule}{0.35pt}
\newcommand{\locTitleRule}{0.35pt}

% ==================================================
% Table Colors
% ==================================================

\colorlet{locTableHeadBackground}{locAccent!8}
\colorlet{locTableHeadText}{locDark}
\colorlet{locTableRule}{locBorder}
\colorlet{locTableRowBackgroundAlt}{locLight}

% ==================================================
% Table Dimensions
% ==================================================

\newlength{\locTableColumnSep}
\setlength{\locTableColumnSep}{6pt}

\newcommand{\locTableRowStretch}{1.15}

\endinput
