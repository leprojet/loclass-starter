\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{boxes}[2026/07/02]

% ==================================================
% Requirements
% ==================================================

\RequirePackage[most]{tcolorbox}
\RequirePackage{fontawesome5}

% ==================================================
% Note
% ==================================================

\newtcolorbox{lonote}{
	enhanced,
	breakable,

	colback=locNoteBackground,
	colbacktitle=white,

	colframe=locNoteBorder,
	coltitle=locNoteTitle,

	boxrule=\locBoxRule,
	titlerule=\locTitleRule,

	arc=\locBoxRadius,

	left=\locBoxPaddingX,
	right=\locBoxPaddingX,
	top=\locBoxPaddingY,
	bottom=\locBoxPaddingY,

	before skip=\locBoxSkip,
	after skip=\locBoxSkip,

	fonttitle=\bfseries,

	title={\faInfoCircle\hspace{0.5em}Hinweis}
}

