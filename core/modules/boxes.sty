\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{loclass-boxes}[2026/07/01 Box Engine]

% --------------------------------------------------
% Requirements
% --------------------------------------------------

\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{fontawesome5}
\RequirePackage[most]{tcolorbox}

% --------------------------------------------------
% Theme Colors
% --------------------------------------------------

\colorlet{locNoteBack}{blue!5}
\colorlet{locNoteFrame}{blue!70!black}

\colorlet{locTipBack}{green!5}
\colorlet{locTipFrame}{green!60!black}

\colorlet{locWarningBack}{orange!5}
\colorlet{locWarningFrame}{orange!80!black}

\colorlet{locImportantBack}{red!5}
\colorlet{locImportantFrame}{red!75!black}

% --------------------------------------------------
% Internal Box Generator
% --------------------------------------------------

\NewDocumentCommand{\loclassDeclareBox}{mmmm}
{
	% #1 Environment
	% #2 Title
	% #3 Icon
	% #4 Style

	\expandafter\newtcolorbox\csname #1\endcsname
	{
		enhanced,
		breakable,

		colback=loc#4Back,
		colframe=loc#4Frame,

		boxrule=0.8pt,
		arc=2mm,

		left=3mm,
		right=3mm,
		top=2mm,
		bottom=2mm,

		fonttitle=\bfseries,

		title=
			{
				#3\hspace{0.5em}#2
			}
	}
}

% --------------------------------------------------
% Public Box Definitions
% --------------------------------------------------

\loclassDeclareBox
{note}
{Hinweis}
{\faInfoCircle}
{Note}

\loclassDeclareBox
{tip}
{Tipp}
{\faLightbulb}
{Tip}

\loclassDeclareBox
{warning}
{Warnung}
{\faExclamationTriangle}
{Warning}

\loclassDeclareBox
{important}
{Wichtig}
{\faExclamationCircle}
{Important}

\endinput
