\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lotest}[2026/07/01 Loclass Playground]

% --------------------------------------------------
% Requirements
% --------------------------------------------------

\RequirePackage[most]{tcolorbox}
\RequirePackage{fontawesome5}

\RequirePackage{themes/default}

% --------------------------------------------------
% Base Box
% --------------------------------------------------

\tcbset{

	loclassbox/.style={
			enhanced,
			breakable,

			colback=white,
			colbacktitle=white,

			boxrule=0.35pt,
			titlerule=0.35pt,

			arc=1mm,

			left=5mm,
			right=5mm,
			top=3mm,
			bottom=3mm,

			before skip=8pt,
			after skip=8pt,

			fonttitle=\bfseries
		},

	loclassnote/.style={
			loclassbox,
			colframe=locNote,
			coltitle=locNote
		},

	locclasstip/.style={
			loclassbox,
			colframe=locTip,
			coltitle=locTip
		},

	loclasswarning/.style={
			loclassbox,
			colframe=locWarning,
			coltitle=locWarning
		},

	loclassimportant/.style={
			loclassbox,
			colframe=locImportant,
			coltitle=locImportant
		}
}

\endinput
