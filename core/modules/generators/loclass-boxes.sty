\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{loclass-boxes}[2026/07/01 Loclass Box Generator]

% --------------------------------------------------
% Requirements
% --------------------------------------------------

\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}

% --------------------------------------------------
% Box Generator
% --------------------------------------------------

\NewDocumentCommand{\loclassNewBox}{mmmm}
{
	\newtcolorbox{#1}{
		enhanced,
		breakable,

		colback=loc#4Background,
		colframe=loc#4Frame,

		boxrule=0.8pt,
		arc=2mm,

		left=3mm,
		right=3mm,
		top=2mm,
		bottom=2mm,

		fonttitle=\bfseries,

		title={#3\hspace{0.5em}#2}
	}
}
\endinput
