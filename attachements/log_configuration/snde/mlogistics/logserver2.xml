<?xml version="1.0" encoding="UTF-8"?>
<Configuration name="default" status="warn" monitorInterval="10" packages="ch.logobject.as.log">

	<Properties>
	
		<!-- Application Name -->
		<Property name="applicationName">mlogistics</Property>
		
		<!-- Active File Path -->
		<Property name="activeFilePath">../../local/log/mlogistics</Property>
		
		<!-- Active File Size -->
		<Property name="activeFileSize">20MB</Property>
		
		<!-- Set this path to whereever you want the Logfiles to be rolled over -->
		<Property name="rolledOverFilesPath">/els/archiv/${hostName}/${applicationName}</Property>
		
		<!-- This is used to make the daily folders. Be carefull when removing to update the paths below -->
		<Property name="rolledOverFilesDatePattern">yyyy-MM-dd</Property>
		
		<!-- use .gz to automatically zip rolled over files -->
		<Property name="rolledOverFilesFormatSuffix">.gz</Property> 
		
		<!-- Directory where the files will be archived -->
		<Property name="archiveDirectoryPath">/els/archiv/${hostName}/mlogistics/arcDir</Property>
	
	</Properties>

	<Appenders>
		<RollingFile 
			name="R" 
			fileName="${activeFilePath}/server/${applicationName}_server.log" 
			filePattern="${rolledOverFilesPath}/server/%d{${rolledOverFilesDatePattern}}/${applicationName}_server.%i.log${rolledOverFilesFormatSuffix}" 
			append="true">
			<Policies>
				<TimeBasedTriggeringPolicy interval="1" modulate="true"/>
				<SizeBasedTriggeringPolicy size="${activeFileSize}" />
				<OnStartupTriggeringPolicy/>	  
			</Policies>
			<DefaultRolloverStrategy fileIndex="min" max="400">
				<Delete basePath="${rolledOverFilesPath}/server" maxDepth="2">
					<IfFileName glob="**/*${rolledOverFilesFormatSuffix}" />
					<IfLastModified age="61d" />
				</Delete>
			</DefaultRolloverStrategy>
			<ArchiveRolloverStrategy fileIndex="min" max="20" archiveCompressionLevel="9" archiveDirectory="${archiveDirectoryPath}/server" />
			<PatternLayout pattern="%d %X{hostname}:%X{port} [%t] %X{jms-type} %X{principal} %-5p %c - %m%n" />
			<ContextMapFilter onMatch="DENY" onMismatch="NEUTRAL" operator="or">
				<KeyValuePair key="jms-id" value="MOT" />
				<KeyValuePair key="jms-id" value="mric" />
				<KeyValuePair key="jms-type" value="mRicErrorMessage" />
				<!-- QUERY SERVLET -->
				<KeyValuePair key="process-id" value="QueryServlet" />
				<!-- QUERY Stream SERVLET -->
				<KeyValuePair key="process-id" value="QueryStreamServlet" />
				<KeyValuePair key="process-id" value="QueryServletMulti" />
				<!-- We don't want the scheduler stuff in the main log -->
				<!-- MANUAL SCHEDULER -->
				<KeyValuePair key="jms-type" value="adjustCalendar" />
				<KeyValuePair key="jms-type" value="preAssignTask" />
				<!-- AUTOMATIC SCHEDULER -->	
				<KeyValuePair key="process-id" value="MLogisticScheduler" />
				<!-- ALIVE -->
				<KeyValuePair key="jms-type" value="notifyAlive" />
				<KeyValuePair key="jms-type" value="isAlivePeriodic" />
				<!-- no locking log -->
				<KeyValuePair key="jms-type" value="getIncidentLockInfo" />
				<KeyValuePair key="jms-type" value="getIncidentLockInfoAll" />
				<KeyValuePair key="jms-type" value="getIncidentActionLockInfo" />
				<KeyValuePair key="jms-type" value="getIncidentProtocolLockInfo" />
				<KeyValuePair key="jms-type" value="getIncidentMessageLockInfo" />
				<KeyValuePair key="jms-type" value="getIncidentLocationLockInfo" />
				<KeyValuePair key="jms-type" value="getIncidentCallLockInfo" />
				<KeyValuePair key="jms-type" value="getIncidentPatientLockInfo" />
				<!-- COMMANDING -->
				<KeyValuePair key="jms-type" value="incidentSelectResourceReq" />
				<KeyValuePair key="jms-type" value="incidentResourcesRouteReq" />
				<KeyValuePair key="jms-type" value="taskSelectResourcesReq" />
				<!-- COMMANDING DEBUG -->
				<KeyValuePair key="process-id" value="COMMANDING_DEBUG" />
				<!-- COMMANDING CACHE -->
				<KeyValuePair key="process-id" value="COMMANDING_CACHE" />
			</ContextMapFilter>
		</RollingFile>
	
    <RollingFile 
		name="AUDIT" 
		fileName="${activeFilePath}/audit/${applicationName}_audit.log" 
		filePattern="${rolledOverFilesPath}/audit/%d{${rolledOverFilesDatePattern}}/${applicationName}_audit.%i.log${rolledOverFilesFormatSuffix}" 
		append="true">
		<Policies>
			<TimeBasedTriggeringPolicy interval="1" modulate="true"/>
			<SizeBasedTriggeringPolicy size="${activeFileSize}" />
			<OnStartupTriggeringPolicy/>	  
		</Policies>
		<DefaultRolloverStrategy>
			<Delete basePath="${rolledOverFilesPath}/audit">
				<IfFileName glob="audit.*.log.gz" />
				<IfLastModified age="P61D" />
			</Delete>
		</DefaultRolloverStrategy>
		<ArchiveRolloverStrategy fileIndex="min" max="20" archiveCompressionLevel="9" archiveDirectory="${archiveDirectoryPath}/audit" />
		<PatternLayout pattern="%d %X{hostname}:%X{port} [%t] %X{client-ip} %X{jms-type} %X{principal} %-5p %c{1} - %m%n" />
    </RollingFile>
	
