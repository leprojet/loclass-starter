			</Delete>
		</DefaultRolloverStrategy>
		<ArchiveRolloverStrategy fileIndex="min" max="20" archiveCompressionLevel="9" archiveDirectory="${archiveDirectoryPath}/processes"/>
		<PatternLayout pattern="%d [%t] %X{jms-type} %X{principal} %-5p %c - %m%n" />
		<ContextMapFilter onMatch="ACCEPT" onMismatch="DENY" operator="or">
			<KeyValuePair key="process-id" value="COMMANDING_DEBUG" />
		</ContextMapFilter>
    </RollingFile>
	
    <RollingFile 
		name="COMMANDING_CACHE" 
		fileName="${activeFilePath}/commanding_cache/${applicationName}_commanding-cache.log" 
		filePattern="${rolledOverFilesPath}/commanding_cache/%d{${rolledOverFilesDatePattern}}/${applicationName}_commanding-cache.%i.log${rolledOverFilesFormatSuffix}" 
		append="true">
		<Policies>
			<TimeBasedTriggeringPolicy interval="1" modulate="true"/>
			<SizeBasedTriggeringPolicy size="${activeFileSize}" />
			<OnStartupTriggeringPolicy/>	  
		</Policies>
		<DefaultRolloverStrategy fileIndex="min" max="400">
			<Delete basePath="${rolledOverFilesPath}/commanding_cache " maxDepth="2">
				<IfFileName glob="**/*${rolledOverFilesFormatSuffix}" />
				<IfLastModified age="61d" />
			</Delete>
		</DefaultRolloverStrategy>
		<ArchiveRolloverStrategy fileIndex="min" max="20" archiveCompressionLevel="9" archiveDirectory="${archiveDirectoryPath}/processes"/>
		<PatternLayout pattern="%d %X{hostname}:%X{port} [%t] %X{jms-type} %X{principal} %-5p %c - %m%n" />
		<ContextMapFilter onMatch="ACCEPT" onMismatch="DENY" operator="or">
			<KeyValuePair key="process-id" value="COMMANDING_CACHE" />
		</ContextMapFilter>
    </RollingFile>

  </Appenders>
  
  
  <Loggers>
    <Logger name="ch.logobject.pushd" level="debug" additivity="false">
      <AppenderRef ref="PUSHD" />
    </Logger>
    <Logger name="ch.logobject.common.logging.Audit" additivity="false">
      <AppenderRef ref="AUDIT" />
    </Logger>
    <Logger name="org.apache.cxf" additivity="false">
      <AppenderRef ref="CXF" />
    </Logger>
    <Root level="debug">
      <AppenderRef ref="R" />
      <AppenderRef ref="WARN" />
      <AppenderRef ref="ERROR" />
      <AppenderRef ref="MOT" />
      <AppenderRef ref="MOT_FORMS" />
      <AppenderRef ref="QUERY_SERVLET" />
      <AppenderRef ref="QUERY_STREAM" />
      <AppenderRef ref="QUERY_SERVLET_MULTI" />
      <AppenderRef ref="SCHEDULER" />
      <AppenderRef ref="ACCESS" />
      <AppenderRef ref="GDI-IMPORT" />
      <AppenderRef ref="ALIVE" />
      <AppenderRef ref="COMMANDING" />
      <AppenderRef ref="COMMANDING_DEBUG" />
      <AppenderRef ref="COMMANDING_CACHE" />
    </Root>
  </Loggers>
</Configuration>
