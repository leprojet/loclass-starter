%%
%% Inline commands
%%

\newcommand{\locInlineBase}[1]{%
  \begingroup
  \ttfamily
  \small
  #1%
  \endgroup
}

\newcommand{\locInlineBox}[1]{%
  \begingroup
  \setlength{\fboxsep}{2pt}%
  \setlength{\fboxrule}{0.35pt}%
  \fbox{\strut #1}%
  \endgroup
}

\newcommand{\locPath}[1]{%
  \locInlineBase{#1}%
}

\newcommand{\locCmd}[1]{%
  \locInlineBase{\$ #1}%
}

\newcommand{\locCode}[1]{%
  \locInlineBase{#1}%
}

\newcommand{\locUrl}[1]{%
  \href{#1}{\locInlineBase{#1}}%
}

\newcommand{\locKeys}[1]{%
  \begingroup
  \sffamily
  \small
  \locInlineBox{#1}%
  \endgroup
}
